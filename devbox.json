{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@latest",
    "kdePackages.plasma-sdk@latest"
  ],
  "shell": {
    "init_hook": [
      "echo -e \"\\033[1;36m🚀 Welcome to the Plasma AI Usage dev environment!\\033[0m\"",
      "echo \"\"",
      "echo -e \"\\033[1;33m📦 To build and install the widget locally:\\033[0m\"",
      "echo -e \"  \\033[0;32mkpackagetool6 -t Plasma/Applet -i .\\033[0m\"",
      "echo \"\"",
      "echo -e \"\\033[1;33m🔄 To update an existing installation:\\033[0m\"",
      "echo -e \"  \\033[0;32mkpackagetool6 -t Plasma/Applet -u .\\033[0m\"",
      "echo \"\"",
      "echo -e \"\\033[1;33m📋 To view logs:\\033[0m\"",
      "echo -e \"  \\033[0;32mjournalctl --user -f | grep -i 'AI Usage'\\033[0m\"",
      "echo \"\"",
      "echo -e \"\\033[1;33m♻️  To restart Plasma Shell (to reload widget):\\033[0m\"",
      "echo -e \"  \\033[0;32mkquitapp6 plasmashell && kstart plasmashell\\033[0m\"",
      "echo \"\"",
      "echo -e \"\\033[1;33m🧪 To test without restarting Plasma (requires plasma-sdk):\\033[0m\"",
      "echo -e \"  \\033[0;32mplasmoidviewer -a .\\033[0m\""
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}

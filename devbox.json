{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@latest"
  ],
  "shell": {
    "init_hook": [
      "echo \"Welcome to the Plasma AI Usage dev environment!\"",
      "echo \"\"",
      "echo \"To build and install the widget locally:\"",
      "echo \"  kpackagetool6 -t Plasma/Applet -i .\"",
      "echo \"\"",
      "echo \"To update an existing installation:\"",
      "echo \"  kpackagetool6 -t Plasma/Applet -u .\"",
      "echo \"\"",
      "echo \"To view logs:\"",
      "echo \"  journalctl --user -f | grep -i 'AI Usage'\"",
      "echo \"\"",
      "echo \"To restart Plasma Shell (to reload widget):\"",
      "echo \"  kquitapp6 plasmashell && kstart plasmashell\""
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}